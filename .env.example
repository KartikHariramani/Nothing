# ==============================================================================
# LIFE SHARE: Environment Variables Configuration
# Tagline: Connecting People. Mobilising Blood. Saving Lives.
# ==============================================================================

# Backend & Database
ENVIRONMENT=development
DATABASE_URL=sqlite:///./lifeshare.db
# For Supabase PostgreSQL direct connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Client Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret
JWT_SECRET=lifeshare-secure-jwt-secret-key-2026-turnout-intelligence
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Bot API (Optional - Automatically falls back to simulated delivery if unset)
TELEGRAM_BOT_TOKEN=7123456789:AAH...
TELEGRAM_BOT_USERNAME=LifeShareBot
TELEGRAM_WEBHOOK_SECRET=lifeshare-tele-secret

# Ollama LLM (Optional - Automatically falls back to high-fidelity template engine if unreachable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Frontend API URL
VITE_API_URL=http://127.0.0.1:8000/api/v1
