# ==============================================================================
# LIFE SHARE (MOBILIZE CIVIC HEALTH SYSTEM) - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Instructions: Copy this file to .env and configure the values for your environment.
# Note: On cloud hosting (e.g. Netlify, Vercel), add these to Site Settings -> Environment Variables.

# Core API Endpoint
# Local Development: http://127.0.0.1:8000/api/v1
# Production: https://your-backend-api.onrender.com/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Application Identity & Spec Metadata
VITE_APP_NAME="Life Share"
VITE_APP_TAGLINE="Mobilize Civic Health System"
VITE_APP_VERSION="3.4.0"
VITE_NODE_ID="NODE #SPEC-NAV-DEL-00"

# Telegram Bot Integration
VITE_TELEGRAM_BOT_USERNAME=life_share_bot
VITE_TELEGRAM_BOT_URL=https://t.me/life_share_bot

# Google Authentication (OAuth 2.0 Web Client ID)
VITE_GOOGLE_CLIENT_ID=example-google-client-id

# Supabase Client Credentials (Public Anon Key ONLY)
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_ANON_KEY=example-supabase-key

# Offline Resilience Mode
VITE_ENABLE_OFFLINE_FALLBACK=true
