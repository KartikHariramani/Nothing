# ==============================================================================
# LIFE SHARE: Frontend Environment Configuration
# ==============================================================================
# This file shows all available frontend environment variables.
# Copy to .env and fill in the values.

# Backend API Endpoint
# LOCAL DEVELOPMENT: http://127.0.0.1:8000/api/v1
# PRODUCTION (Render): https://lifeshare-backend.onrender.com/api/v1
# PRODUCTION (Custom): https://api.your-domain.com/api/v1
#
# IMPORTANT: On Netlify, set this as an environment variable in
# Site Settings → Environment Variables. The .env file is NOT deployed.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Supabase Client Credentials (Public Anon Key only — NEVER include Service Role Key)
# Only needed if you switch to Supabase Auth in the future
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Telegram Bot Handle for Direct Mobilisation Links
VITE_TELEGRAM_BOT_USERNAME=life_share_bot
